{
  "name": "live-coding",
  "version": "1.0.0",
  "description": "Live Coding Map: SQL and Python live-coding interview preparation with in-browser PostgreSQL and Python (EN/RU).",
  "scripts": {
    "runtimes": "node scripts/copy-runtimes.mjs",
    "predev": "node scripts/copy-runtimes.mjs",
    "prebuild": "node scripts/copy-runtimes.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "exercises": "node scripts/build-exercises.mjs",
    "check:solutions": "cd exercises && SOLUTIONS=1 uv run --locked pytest -q",
    "flashcards": "node scripts/export-flashcards.mjs",
    "check:links": "python3 scripts/check_links.py dist",
    "check:external": "node scripts/check-external-links.mjs",
    "check:content": "node scripts/check-mdx.mjs $(find src/content/docs -name '*.mdx')",
    "test:e2e": "node scripts/e2e.mjs",
    "og-images": "node scripts/make-og-images.mjs",
    "demo-gif": "node scripts/make-demo-gif.mjs"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/starlight": "^0.42.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "^7.3.7",
    "codemirror": "^6.0.2",
    "pyodide": "314.0.7",
    "sharp": "^0.35.5",
    "unist-util-visit": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1"
  }
}
