---
// The mock interview starter: pick SQL, Python or both, and "Start" opens a random task on its
// mock page, /mock/<id>/, an address that names no topic (MockPage.astro; setupMock in
// lib/client.ts). By default the task comes from the pages of the reader's study plan (readPlan()
// in lib/plan-store.ts, `medium` when missing); "Any task" lifts that. Tasks the reader has already
// solved (progress `ex:<id>`) are skipped while unsolved ones are left. "Both" queues a SQL task
// and then a Python one; the queue and the clock live in sessionStorage ('lcm-mock', lib/mock.ts).
//   <MockInterview />          the picker
//   <MockInterview review />   the self-review checklist, the same list the end of a mock shows
import { sqlTasks } from '~/data/practice/sql-tasks';
import { pyTasks } from '~/data/practice/py-tasks';
import { studyPhases, timelines } from '~/data/study-plan';
import { getTask, localeOf } from './lib/data';
import { strings } from './lib/i18n';
import { mockHref, mockMinutes } from './lib/mock';
import { taskPages } from './lib/task-pages';
import './practice.css';

interface Props {
  /** Render the self-review checklist instead of the picker. */
  review?: boolean;
}
const { review = false } = Astro.props;
const locale = localeOf(Astro);
const T = strings(locale);
// The page that shows each task: the study plan's filter works on pages. A task on no page has no
// mock page either.
const where = await taskPages();
type Item = { id: string; url: string; mins: number; page: string };
const list = (ids: string[]): Item[] =>
  ids.flatMap((id) => {
    const w = where[id];
    return w ? [{ id, url: mockHref(id, locale === 'ru'), mins: mockMinutes(getTask(id).task.target), page: w.en ?? w.ru ?? '' }] : [];
  });
// The pages each study plan goes through (src/data/study-plan.ts).
const plans = Object.fromEntries(
  timelines.map((t) => [
    t.id,
    {
      name: `${t.name[locale]} (${t.duration[locale]})`,
      pages: studyPhases.flatMap((ph) => ph.steps.filter((s) => s.timelines.includes(t.id)).map((s) => s.path)),
    },
  ]),
);
const cfg = { sql: list(sqlTasks.map((t) => t.id)), py: list(pyTasks.map((t) => t.id)), plans };
---
{review ? (
  <ul class="lcp-checklist lcp-checklist-page not-content" data-checklist>
    {T.mockChecklist.map((t) => (
      <li><label><input type="checkbox" /> <span>{t}</span></label></li>
    ))}
  </ul>
) : (
  <section class="lcp lcp-mockpick not-content" data-mock-pick>
    <script type="application/json" data-mock-cfg set:html={JSON.stringify(cfg).replace(/</g, '\\u003c')} />
    <fieldset>
      <legend>{T.mockPick}</legend>
      <label><input type="radio" name="lcm-mock-kind" value="sql" checked /> {T.mockSql}</label>
      <label><input type="radio" name="lcm-mock-kind" value="py" /> {T.mockPy}</label>
      <label><input type="radio" name="lcm-mock-kind" value="both" /> {T.mockBoth}</label>
    </fieldset>
    <label><input type="checkbox" data-mock-unsolved checked /> {T.mockAvoidSolved}</label>
    <label><input type="checkbox" data-mock-any /> {T.mockAny}</label>
    <p class="lcp-small lcp-muted lcp-mockpick-plan" data-mock-plan>{T.mockPlan(plans.medium.name)}</p>
    <div class="lcp-bar">
      <button type="button" class="lcp-btn lcp-btn-primary" data-mock-start>{T.mockStart}</button>
    </div>
    <p class="lcp-small lcp-mockpick-msg" data-mock-msg role="status" hidden>{T.mockNone}</p>
  </section>
)}

<script>
  import { loadProgress } from '../lib/progress';
  import { strings } from './lib/i18n';
  import { readPlan } from '../lib/plan-store';
  import { writeMock, type MockItem } from './lib/mock';

  const T = strings(document.documentElement.lang?.toLowerCase().startsWith('ru') ? 'ru' : 'en');
  type Item = MockItem & { page: string };
  type Cfg = { sql: Item[]; py: Item[]; plans: Record<string, { name: string; pages: string[] }> };
  for (const root of document.querySelectorAll<HTMLElement>('[data-mock-pick]')) {
    const cfg: Cfg = JSON.parse(root.querySelector('[data-mock-cfg]')!.textContent || '{}');
    const msg = root.querySelector<HTMLElement>('[data-mock-msg]')!;
    const plan = cfg.plans[readPlan()] ?? cfg.plans.medium;
    root.querySelector<HTMLElement>('[data-mock-plan]')!.textContent = T.mockPlan(plan.name);
    const inPlan = new Set(plan.pages);
    const pick = (items: Item[], any: boolean, skipSolved: boolean): Item | null => {
      const planned = any ? items : items.filter((x) => inPlan.has(x.page));
      const base = planned.length ? planned : items;
      const solved = loadProgress().activities;
      const fresh = skipSolved ? base.filter((x) => !solved[`ex:${x.id}`]) : base;
      const pool = fresh.length ? fresh : base;
      return pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
    };
    root.querySelector('[data-mock-start]')!.addEventListener('click', () => {
      const kind = root.querySelector<HTMLInputElement>('input[name="lcm-mock-kind"]:checked')?.value ?? 'sql';
      const skip = root.querySelector<HTMLInputElement>('[data-mock-unsolved]')!.checked;
      const any = root.querySelector<HTMLInputElement>('[data-mock-any]')!.checked;
      const queue = [kind !== 'py' ? pick(cfg.sql, any, skip) : null, kind !== 'sql' ? pick(cfg.py, any, skip) : null]
        .filter((x): x is Item => !!x)
        .map(({ id, url, mins }) => ({ id, url, mins }));
      if (!queue.length) {
        msg.hidden = false;
        return;
      }
      // Each task gets its own clock; "both" gets the sum.
      writeMock({ queue, back: location.pathname, count: queue.length, total: queue.reduce((t, q) => t + q.mins, 0) });
      location.href = queue[0].url;
    });
  }
</script>
