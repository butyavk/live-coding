---
// Study plan: choose a timeline, tick off steps, see progress. A tick marks the step's page as
// learned (shared with the skill map); the chosen plan is shared with the map too
// (lib/plan-store.ts). Each step shows the exercises it asks for and how many have passed Check.
// Hours come from the same estimate as the map (lib/skill-map-data.ts), not from typed numbers.
// Server-renders the default plan so it works without JavaScript.
import { studyPhases, timelines, countsIn, shownIn, stepKeys, DEFAULT_TIMELINE, type Timeline } from '~/data/study-plan';
import { planTimes } from './lib/skill-map-data';
import { RESET_TEXT } from './lib/plan-store';
import { fixed } from './lib/format';

interface Props {
  initial?: Timeline;
}

const { initial = DEFAULT_TIMELINE } = Astro.props;
const locale = Astro.locals.starlightRoute?.locale === 'ru' ? 'ru' : 'en';
const uid = `sp-${Math.random().toString(36).slice(2, 8)}`;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const href = (path: string) => `${base}${locale === 'ru' ? 'ru/' : ''}${path}`;

const T = {
  en: {
    choose: 'How much time do you have?',
    progress: 'Progress',
    of: 'of',
    steps: 'steps done',
    stepsOne: 'steps done',
    aim: 'Aim',
    saved: 'Progress is saved in this browser only and shared with the',
    map: 'skill map.',
    done: 'All done. Now keep practising out loud.',
    hours: (h: number, lo: string, hi: string) => `about ${h} h: ${lo === hi ? lo : `${lo}–${hi}`} h a day`,
    optHours: (h: string) => `optional steps: ${h} h more`,
    optional: 'optional',
    exWord: 'exercises',
    learn: 'All solved: mark as learned',
    exTotal: (x: number, y: number) => `${x} of ${y} ${y === 1 ? 'exercise' : 'exercises'} solved`,
    exHelp: 'Exercises count when they pass Check on their page.',
  },
  ru: {
    choose: 'Сколько у вас времени?',
    progress: 'Прогресс',
    of: 'из',
    steps: 'шагов выполнено',
    stepsOne: 'шага выполнено',
    aim: 'Цель',
    saved: 'Прогресс хранится только в этом браузере и виден также на',
    map: 'карте навыков.',
    done: 'Всё пройдено. Теперь продолжайте тренироваться вслух.',
    hours: (h: number, lo: string, hi: string) => `около ${h} ч: ${lo === hi ? lo : `${lo}–${hi}`} ч в день`,
    optHours: (h: string) => `шаги по желанию: ещё ${h} ч`,
    optional: 'по желанию',
    exWord: 'упражнения',
    learn: 'Всё решено: отметить изученным',
    exTotal: (x: number, y: number) => `решено ${x} из ${y} ${y % 10 === 1 && y % 100 !== 11 ? 'упражнения' : 'упражнений'}`,
    exHelp: 'Упражнение засчитывается, когда на его странице проходит проверка.',
  },
}[locale];
const R = RESET_TEXT[locale];

// A step is stored as the page it links to (shared with the skill map); a later step that
// links to an already-used page is an activity of its own (e.g. the mock interview).
const keyOf = stepKeys();
const mapHref = href('start/skill-map/');
const { plans, steps: info } = await planTimes(locale);
const TL = timelines.map((t) => t.id);

const countFor = (tl: Timeline) => plans[tl].steps;
// "30 шагов", "21 шаг", "23 шага"; after «из» the genitive: "из 21 шага", "из 30 шагов".
const stepWord = (n: number) =>
  locale === 'ru'
    ? n % 10 === 1 && n % 100 !== 11 ? 'шаг' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'шага' : 'шагов'
    : n === 1 ? 'step' : 'steps';
const stepsDone = (total: number) => (total % 10 === 1 && total % 100 !== 11 ? T.stepsOne : T.steps);
const h1 = (h: number) => fixed(h, locale, 0, 1);
const hoursText = (tl: Timeline) => {
  const p = plans[tl];
  return T.hours(Math.round(p.minutes / 60), h1(p.perDay[0]), h1(p.perDay[1]));
};
const optText = (tl: Timeline) => (plans[tl].optional ? T.optHours(h1(Math.max(0.5, Math.round((plans[tl].optional / 60) * 2) / 2))) : '');
// The checklist line of a step in a timeline; `{min}` is the estimate for that step.
const labelFor = (step: (typeof studyPhases)[number]['steps'][number], tl: Timeline) =>
  (step.scope?.[tl]?.task ?? step.task)[locale].replace('{min}', String(info.get(step.id)?.min[tl] ?? ''));
const exFor = (stepId: string, tl: Timeline) => info.get(stepId)?.ex[tl] ?? [];
const exTotalFor = (tl: Timeline) => new Set(studyPhases.flatMap((ph) => ph.steps.filter((s) => countsIn(s, tl)).flatMap((s) => exFor(s.id, tl)))).size;
const clientData = { locale, t: { of: T.of, steps: T.steps, stepsOne: T.stepsOne, done: T.done, exWord: T.exWord } };
---

<div class="sp not-content" id={uid} data-sp data-timeline={initial}>
  <script type="application/json" data-sp-json set:html={JSON.stringify(clientData)} />

  <fieldset class="sp-choose">
    <legend class="sp-legend">{T.choose}</legend>
    <div class="sp-options">
      {timelines.map((tl) => (
        <label class="sp-option">
          <input type="radio" name={`${uid}-tl`} value={tl.id} checked={tl.id === initial} />
          <span class="sp-option-body">
            <span class="sp-option-name">
              {tl.name[locale]} <span class="sp-option-dur">· {tl.duration[locale]}</span>
            </span>
            <span class="sp-option-sum">{tl.summary[locale]}</span>
            <span class="sp-option-count">
              <span class="sp-option-steps">{countFor(tl.id)} {stepWord(countFor(tl.id))}</span>
              <span class="sp-option-hours" data-sp-hours>{hoursText(tl.id)}</span>
              {optText(tl.id) && <span class="sp-option-opt">{optText(tl.id)}</span>}
            </span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="sp-progress">
    <div class="sp-progress-head">
      <span class="sp-progress-label" id={`${uid}-pl`}>{T.progress}</span>
      <span class="sp-progress-text" aria-live="polite" data-sp-text>0 {T.of} {countFor(initial)} {stepsDone(countFor(initial))}</span>
    </div>
    <div class="sp-bar" role="progressbar" aria-labelledby={`${uid}-pl`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-sp-bar>
      <span class="sp-bar-fill" data-sp-fill></span>
    </div>
    <p class="sp-ex-total" data-sp-ex-total title={T.exHelp}>{T.exTotal(0, exTotalFor(initial))}</p>
    <div class="sp-progress-foot">
      <span class="sp-saved">{T.saved} <a href={mapHref}>{T.map}</a></span>
      <button type="button" class="sp-reset" data-reset-open aria-expanded="false" aria-controls={`${uid}-reset`}>{R.button}</button>
    </div>
    <div class="sp-reset-panel" id={`${uid}-reset`} data-reset-panel hidden>
      <p>{R.ask}</p>
      <label class="sp-reset-drafts"><input type="checkbox" data-reset-drafts /> {R.drafts}</label>
      <div class="sp-reset-actions">
        <button type="button" class="sp-reset sp-reset--yes" data-reset-yes>{R.yes}</button>
        <button type="button" class="sp-reset" data-reset-no>{R.no}</button>
      </div>
    </div>
    <p class="sp-reset-msg" data-reset-msg data-done={R.done} aria-live="polite"></p>
  </div>

  <ol class="sp-phases">
    {studyPhases.map((phase, pi) => (
      <li class="sp-phase" data-phase={phase.id}>
        <div class="sp-phase-head">
          <h3 class="sp-phase-title">
            <span class="sp-phase-num" aria-hidden="true">{pi + 1}</span>
            {phase.title[locale]}
          </h3>
          <span class="sp-phase-count" data-sp-count></span>
        </div>
        {timelines.map((tl) => (
          <p class="sp-aim" data-for={tl.id} hidden={tl.id !== initial}>
            <span class="sp-aim-label">{T.aim}:</span> {phase.aim[tl.id][locale]}
          </p>
        ))}
        <ul class="sp-steps">
          {phase.steps.map((step) => (
            <li
              class:list={['sp-step', { 'is-opt': step.optional?.includes(initial) }]}
              data-step={step.id}
              data-key={keyOf.get(step.id)}
              data-tl={step.timelines.join(' ')}
              data-opt={(step.optional ?? []).join(' ')}
              {...Object.fromEntries(TL.flatMap((tl) => [[`data-l-${tl}`, labelFor(step, tl)], [`data-ex-${tl}`, exFor(step.id, tl).join(' ')]]))}
              hidden={!shownIn(step, initial)}
            >
              <input type="checkbox" id={`${uid}-${step.id}`} aria-labelledby={`${uid}-${step.id}-l`} />
              <span class="sp-step-body">
                <a id={`${uid}-${step.id}-l`} href={href(step.path)}>{labelFor(step, initial)}</a>
                <span class="sp-step-meta">
                  <span class="sp-tag" data-sp-opt hidden={!step.optional?.includes(initial)}>{T.optional}</span>
                  <span class="sp-ex" data-sp-ex hidden={!exFor(step.id, initial).length}>{T.exWord}: 0/{exFor(step.id, initial).length}</span>
                  <button type="button" class="sp-learn" data-sp-learn hidden>{T.learn}</button>
                </span>
              </span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</div>

<style>
  .sp {
    margin-block: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    container-type: inline-size;
  }
  .sp-choose { border: 0; padding: 0; margin: 0; min-width: 0; }
  .sp-legend { font-weight: 600; color: var(--sl-color-white); margin-bottom: 0.6rem; padding: 0; font-size: var(--sl-text-base); }
  .sp-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .sp-option { position: relative; cursor: pointer; display: block; }
  .sp-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .sp-option-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.75rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    line-height: 1.4;
  }
  .sp-option:hover .sp-option-body { border-color: var(--sl-color-gray-3); }
  .sp-option input:checked + .sp-option-body {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    box-shadow: inset 0 0 0 1px var(--sl-color-accent);
  }
  .sp-option input:focus-visible + .sp-option-body { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .sp-option-name { font-weight: 700; color: var(--sl-color-white); }
  .sp-option-dur { font-weight: 400; color: var(--sl-color-gray-2); }
  .sp-option-sum { font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
  .sp-option-count { margin-top: auto; padding-top: 0.2rem; font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); }

  .sp-progress {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--sl-color-hairline-light, var(--sl-color-gray-5));
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    position: sticky;
    top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height, 0rem) + 0.5rem);
    z-index: 2;
  }
  :global(:root[data-theme='dark']) .sp-progress { background: var(--sl-color-gray-6); }
  .sp-progress-head,
  .sp-progress-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }
  .sp-progress-label { font-weight: 600; color: var(--sl-color-white); }
  .sp-progress-text { font-variant-numeric: tabular-nums; color: var(--sl-color-gray-2); }
  .sp-bar {
    margin: 0.5rem 0;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    overflow: hidden;
  }
  .sp-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--sl-color-accent);
    border-radius: 999px;
  }
  .sp-saved { font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); }
  .sp-reset {
    font: inherit;
    font-size: var(--sl-text-xs);
    padding: 0.3rem 0.7rem;
    border-radius: 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    cursor: pointer;
    min-height: 2rem;
  }
  .sp-reset:hover { border-color: var(--sl-color-red); }
  .sp-reset:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }

  .sp-phases { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 1.25rem; }
  .sp-phase { margin: 0; }
  .sp-phase[hidden] { display: none; }
  .sp-phase-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline-light, var(--sl-color-gray-5));
    padding-bottom: 0.35rem;
  }
  .sp-phase-title {
    margin: 0;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1.3;
  }
  .sp-phase-num {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }
  .sp-phase.is-complete .sp-phase-num { background: var(--sl-color-accent); color: var(--sl-color-text-invert); }
  .sp-phase-count { flex: none; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; }
  .sp-aim { margin: 0.5rem 0 0.25rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); line-height: 1.5; }
  .sp-aim-label { font-weight: 600; color: var(--sl-color-white); }
  .sp-steps { list-style: none; margin: 0; padding: 0; }
  .sp-step {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.4rem 0.25rem;
    margin: 0;
    border-bottom: 1px solid var(--sl-color-hairline);
    line-height: 1.45;
  }
  .sp-step[hidden] { display: none; }
  .sp-step input {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.12rem 0 0;
    accent-color: var(--sl-color-accent);
    cursor: pointer;
  }
  .sp-step input:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .sp-step a { color: var(--sl-color-white); text-decoration-color: var(--sl-color-gray-4); text-underline-offset: 0.2em; }
  .sp-step a:hover { color: var(--sl-color-text-accent); text-decoration-color: currentColor; }
  .sp-step.is-done a { color: var(--sl-color-gray-3); text-decoration: line-through; text-decoration-color: var(--sl-color-gray-4); }

  .sp-option-count { display: flex; flex-direction: column; gap: 0.1rem; }
  .sp-option-hours { color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }
  .sp-option-opt { color: var(--sl-color-gray-3); }
  .sp-ex-total { margin: 0 0 0.4rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }
  .sp-reset-panel {
    margin-top: 0.6rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--sl-color-red, var(--sl-color-gray-4));
    border-radius: 0.45rem;
    background: var(--sl-color-bg);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .sp-reset-panel[hidden] { display: none; }
  .sp-reset-panel p { margin: 0 0 0.45rem; }
  .sp-reset-drafts { display: flex; align-items: flex-start; gap: 0.45rem; cursor: pointer; }
  .sp-reset-drafts input { margin: 0.2rem 0 0; accent-color: var(--sl-color-accent); }
  .sp-reset-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.55rem; }
  .sp-reset--yes { border-color: var(--sl-color-red, var(--sl-color-gray-4)); }
  .sp-reset-msg { margin: 0.3rem 0 0; font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); min-height: 0; }
  .sp-reset-msg:empty { display: none; }
  .sp-step-body { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6rem; min-width: 0; }
  .sp-step-body > a { min-width: 0; overflow-wrap: anywhere; }
  .sp-step-meta { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; font-size: var(--sl-text-2xs); color: var(--sl-color-gray-3); }
  .sp-step-meta:not(:has(> :not([hidden]))) { display: none; }
  .sp-ex { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sp-ex.is-all { color: var(--sl-color-text-accent); font-weight: 600; }
  .sp-tag {
    padding: 0 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    white-space: nowrap;
  }
  .sp-step.is-opt a { color: var(--sl-color-gray-2); }
  .sp-learn {
    font: inherit;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.35rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    cursor: pointer;
    min-height: 1.6rem;
  }
  .sp-learn:hover { background: var(--sl-color-accent); color: var(--sl-color-text-invert); }
  .sp-learn:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  [hidden] { display: none !important; }

  @media (prefers-reduced-motion: no-preference) {
    .sp-bar-fill { transition: width 0.3s ease; }
  }
  @container (max-width: 34rem) {
    .sp-options { grid-template-columns: 1fr; }
    .sp-option-count { margin-top: 0; }
    .sp-progress { position: static; }
  }
</style>

<script>
  import { loadProgress, onProgressChange, update } from './lib/progress';
  import { onPlanChange, readPlan, solvedOf, wireReset, writePlan } from './lib/plan-store';
  import type { Timeline } from '~/data/study-plan';

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const { locale, t } = JSON.parse(root.querySelector('[data-sp-json]')!.textContent || '{}') as { locale: 'en' | 'ru'; t: Record<string, string> };
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const steps = [...root.querySelectorAll<HTMLLIElement>('.sp-step')];
    const phases = [...root.querySelectorAll<HTMLLIElement>('.sp-phase')];
    const text = root.querySelector<HTMLElement>('[data-sp-text]')!;
    const exTotal = root.querySelector<HTMLElement>('[data-sp-ex-total]')!;
    const bar = root.querySelector<HTMLElement>('[data-sp-bar]')!;
    const fill = root.querySelector<HTMLElement>('[data-sp-fill]')!;

    let tl: Timeline = readPlan();
    const has = (li: HTMLElement, attr: string) => (li.getAttribute(attr) || '').split(' ').includes(tl);

    const isDone = (key: string) => {
      const p = loadProgress();
      return key.startsWith('page:') ? !!p.learned[key.slice(5)] : !!p.activities[key.slice(4)];
    };
    const setDone = (key: string, on: boolean) =>
      update((p) => {
        const [bucket, id] = key.startsWith('page:') ? [p.learned, key.slice(5)] : [p.activities, key.slice(4)];
        if (on) bucket[id] = Date.now();
        else delete bucket[id];
      });
    const exWords = (x: number, y: number) =>
      locale === 'ru' ? `решено ${x} из ${y} ${y % 10 === 1 && y % 100 !== 11 ? 'упражнения' : 'упражнений'}` : `${x} of ${y} ${y === 1 ? 'exercise' : 'exercises'} solved`;

    function render() {
      root.dataset.timeline = tl;
      for (const r of radios) r.checked = r.value === tl;
      const progress = loadProgress();
      let total = 0;
      let ticked = 0;
      const allEx = new Set<string>();
      for (const li of steps) {
        const counted = has(li, 'data-tl') && !has(li, 'data-opt');
        const shown = has(li, 'data-tl') || has(li, 'data-opt');
        li.hidden = !shown;
        li.classList.toggle('is-opt', shown && !counted);
        li.querySelector<HTMLElement>('[data-sp-opt]')!.hidden = !(shown && !counted);
        const label = li.getAttribute(`data-l-${tl}`);
        const a = li.querySelector('a')!;
        if (label && a.textContent !== label) a.textContent = label;
        const cb = li.querySelector('input')!;
        const done = isDone(li.dataset.key!);
        cb.checked = done;
        li.classList.toggle('is-done', done);
        // Exercises this step asks for in this plan, and how many have passed Check.
        const ex = (li.getAttribute(`data-ex-${tl}`) || '').split(' ').filter(Boolean);
        const solved = solvedOf(ex, progress);
        const exEl = li.querySelector<HTMLElement>('[data-sp-ex]')!;
        exEl.hidden = !ex.length;
        exEl.textContent = `${t.exWord}: ${solved}/${ex.length}`;
        exEl.classList.toggle('is-all', ex.length > 0 && solved === ex.length);
        li.querySelector<HTMLElement>('[data-sp-learn]')!.hidden = !(ex.length > 0 && solved === ex.length && !done);
        if (counted) {
          total++;
          if (done) ticked++;
          ex.forEach((id) => allEx.add(id));
        }
      }
      for (const ph of phases) {
        const visible = [...ph.querySelectorAll<HTMLLIElement>('.sp-step')].filter((s) => !s.hidden);
        const counted = visible.filter((s) => !s.classList.contains('is-opt'));
        const d = counted.filter((s) => s.classList.contains('is-done')).length;
        ph.hidden = visible.length === 0;
        ph.querySelector('[data-sp-count]')!.textContent = `${d} / ${counted.length}`;
        ph.classList.toggle('is-complete', counted.length > 0 && d === counted.length);
        ph.querySelectorAll<HTMLElement>('.sp-aim').forEach((a) => (a.hidden = a.dataset.for !== tl));
      }
      const pct = total ? Math.round((ticked / total) * 100) : 0;
      fill.style.width = `${pct}%`;
      bar.setAttribute('aria-valuenow', String(pct));
      bar.setAttribute('aria-valuetext', `${pct}%`);
      text.textContent = ticked === total && total > 0 ? `${ticked} ${t.of} ${total} — ${t.done}` : `${ticked} ${t.of} ${total} ${total % 10 === 1 && total % 100 !== 11 ? t.stepsOne : t.steps}`;
      exTotal.textContent = exWords(solvedOf([...allEx], progress), allEx.size);
    }

    for (const r of radios) {
      r.addEventListener('change', () => {
        if (!r.checked) return;
        tl = r.value as Timeline;
        writePlan(tl);
        render();
      });
    }
    for (const li of steps) {
      const cb = li.querySelector('input')!;
      // Ticking one step ticks every step that points at the same page.
      cb.addEventListener('change', () => setDone(li.dataset.key!, cb.checked));
      li.querySelector('[data-sp-learn]')!.addEventListener('click', () => {
        setDone(li.dataset.key!, true);
        cb.focus();
      });
    }
    wireReset(root);
    onProgressChange(render);
    onPlanChange(() => {
      tl = readPlan();
      render();
    });
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-sp]').forEach(init);
</script>
